;
# diff-ref-struct control file (https://jmigartua.github.io/diff-ref-struct-site/)
format = "diff-ref-struct 1"
title = "SrScLRRT P21/n modes LR RT"
radiation = "neutron"                   # x-ray or neutron

[pattern]
data = "/home/user/diff-ref-struct/manuals/fullprof/runs/modes/A_modes/SrScLRRT.dat" # relative to this file
reader = "free_steps"                   # drs data formats
wavelength_1 = 1.59509                  # Å
wavelength_2 = 1.59509                  # Å
wavelength_ratio = 0.0
zero_shift = 0.08335182381363093        # deg 2θ
sample_displacement = 0.0               # deg 2θ
sample_transparency = 0.0               # deg 2θ
geometry = "debye-scherrer"             # corrected, debye-scherrer, flat-plate-psd, transmission, synchrotron
monochromator_polarisation = 0.0
polarisation_fraction = 0.0
absorption_mur = 0.0
peak_window = 30.0                      # FWHM
asymmetry_limit = 50.0                  # deg 2θ
preferred_orientation_function = "exponential" # march-dollase or exponential
weighting = "variance"                  # variance, maximum-likelihood or unit
excluded_regions = [
  [0.0, 17.5],
  [150.0, 159.9],
] # deg 2θ

