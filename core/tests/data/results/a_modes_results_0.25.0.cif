  [134.8, 265.333],
  [144.85, 292.333],
  [149.55, 277.0],
  [157.0, 278.667],
] # [2θ (deg), counts]

[pattern.fullprof]                     # as the imported .pcr wrote them, for the export back to FullProf
range = [0.0, 0.05, 159.9]              # Thmin, Step, Thmax (deg 2θ)
excluded_regions = [
  [0.0, 17.5],
  [150.0, 161.0],
] # deg 2θ, under FullProf's rule

[[phase]]
name = "Sr2 Sc Sb O6              FIX xyz"
space_group = "P 2_1/n"                 # Hermann–Mauguin
hall = "-P 2yn"                         # Hall symbol: the operators
cell_a = 5.694360312946686              # Å
cell_b = 5.680040032103354              # Å
cell_c = 8.026163889361621              # Å
cell_alpha = 90.0                       # deg
cell_beta = 90.05046410071864           # deg
cell_gamma = 90.0                       # deg
profile = "thompson-cox-hastings"       # gaussian, lorentzian, pseudo-voigt, thompson-cox-hastings
scale_factor = 1.0929613461388084       # arbitrary
overall_b = 0.0                         # Å²
pv_eta0 = 0.0
caglioti_u = 0.15065516590583028        # deg²
caglioti_v = -0.42022290124261047       # deg²
caglioti_w = 0.38017805734282945        # deg²
lorentzian_strain = 0.04379405867131156 # deg
lorentzian_size = 0.0                   # deg
