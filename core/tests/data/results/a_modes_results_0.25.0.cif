po_g2 = 0.0
po_direction = [1.0, 0.0, 0.0]          # reciprocal-lattice components
qpa_atz = 875.885                       # g/mol
brindley_coefficient = 1.0
le_bail = false                         # intensities extracted (profile matching)
mode_fst = [2]                          # FullProf's FullProf Studio output (A_MODES line)

