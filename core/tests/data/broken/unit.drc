  ["phase1.berar_baldinozzi.1", 1.0],
  ["phase1.berar_baldinozzi.2", 1.0, "phase1.berar_baldinozzi.1", 3.0],
]

[convention]
# true: FullProf's rule where it departs from the papers (the compatibility layer); false: the papers' (L050).
lorentz_polarisation = false
berar_baldinozzi = false
axial_divergence = false
preferred_orientation = false
excluded_points = false
peak_window = true
reflections = true
microstructure = false
angle_restraints = false
window_edge = true
