{
  "name": "drs-app",
  "private": true,
  "version": "0.54.0",
  "description": "diff-ref-struct, the Mac app (Tauri). The window is plain HTML/JS in ui/; the Rust side is in src-tauri/.",
  "scripts": {
    "tauri": "tauri",
    "generate": "python3 tools/gen_releases.py && python3 tools/gen_manual.py && node tools/vendor.js",
    "predev": "npm run generate",
    "prebuild": "npm run generate",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test ui/tests/",
    "bundle-viewer": "node ui/tools/bundle-viewer.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2",
    "codemirror": "^6.0.2",
    "dockview-core": "^4.13.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "katex": "^0.16.47",
    "three": "^0.186.1"
  },
  "dependencies": {
    "canvas2svg": "^1.0.16"
  }
}
