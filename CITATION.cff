    affiliation: "Departamento de Física, Universidad del País Vasco / Euskal Herriko Unibertsitatea (UPV/EHU)"
repository-code: "https://github.com/jmigartua/diff-ref-struct-web"
url: "https://jmigartua.github.io/diff-ref-struct-web/"
keywords:
  - powder diffraction
  - in situ
  - Rietveld
  - WebAssembly
  - data visualisation
